    en: 
  - key: card.desc.28
    ko: "\uD654\uB09C \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uD3C9\uC18C\uC758 \uD558\uB12C\uC774\uB124\uC694."
    jp: 
    en: 
  - key: card.desc.29
    ko: "\uC6C3\uB294 \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC88B\uC740 \uC77C\uC774\uB77C\uB3C4

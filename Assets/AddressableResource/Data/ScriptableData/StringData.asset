  - key: Tower.Boss.Name.07
    ko: "\uCC0C\uADF8\uB7EC\uC9C4 \uD574\uD53C \uD558\uB12C"
    jp: 
    en: 
  - key: Tower.Boss.Name.08
    ko: "\uBCFC\uB4DC \uB9C8\uCEE4"
    jp: 
    en: 
  - key: Tower.Boss.Desc.00
    ko: "\uBCF4\uBA74 \uBCFC\uC218\uB85D \uC880 \uBA4D\uCCAD\uD574 \uBCF4\uC774\uB294
      \uD558\uB12C\uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: Tower.Boss.Desc.01
    ko: "\uD3C9\uC18C\uCC98\uB7FC \uD654\uAC00 \uC794\uB729 \uB098 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAFC0\uBC24
      \uD30C\uC6CC\uAC00 \uB354 \uAC15\uD560\uC9C0\uB3C4?(\uC544\uB2D8)"
    jp: 
    en: 
  - key: Tower.Boss.Desc.02
    ko: "\uB9DB\uC788\uC5B4 \uBCF4\uC774\uB294 \uC18C\uC2DC\uC9C0\uB124\uC694.\n\n\uC544\uB2C8
      \uC798 \uBCF4\uB2C8\uAE4C \uD558\uB12C\uC785\uB2C8\uB2E4!"
    jp: 
    en: 
  - key: Tower.Boss.Desc.03
    ko: "\uC0B0\uD0C0 \uD558\uB77C\uBD80\uC9C0\uB97C \uC774\uAE30\uBA74 \uC120\uBB3C\uC744
      \uC794\uB729 \uC904 \uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    jp: 
    en: 
  - key: Tower.Boss.Desc.04
    ko: "\uC655\uC9C0\uB77D \uC637 \uB54C\uBB38\uC5D0 \uBC29\uC5B4\uB825\uC774 \uAC15\uD560\uC9C0\uB3C4
      \uBAA8\uB985\uB2C8\uB2E4.(\uC544\uB2D8)"
    jp: 
    en: 
  - key: Tower.Boss.Desc.05
    ko: "\uC218\uCD08\uC0DD\uC5D0\uC11C \uBCF8 \uD558\uB12C\uC785\uB2C8\uB2E4.\n\n\uB9C8\uC778\uD06C\uB798\uD504\uD2B8
      \uD034\uC988\uB97C \uB9DE\uCD94\uC9C0 \uBABB\uD55C \uC790\uB97C \uCC3E\uC544
      \uAFC0\uBC24\uC744 \uB54C\uB9AC\uB824\uACE0 \uD569\uB2C8\uB2E4."
    jp: 
    en: 
  - key: Tower.Boss.Desc.06
    ko: "\uD478\uB529\u2026 \uC774\uC774\uC775\u2026 \uD478\uB529\u2026.."
    jp: 
    en: 
  - key: Tower.Boss.Desc.07
    ko: "\uC0B4\uC9DD \uCC0C\uADF8\uB7EC\uC84C\uC9C0\uB9CC \uD589\uBCF5\uD55C \uD558\uB12C\uC785\uB2C8\uB2E4.\n\n\uAFC0\uBC24\uC744
      \uB54C\uB824 \uD3C9\uC18C\uC758 \uD654\uB09C \uD558\uB12C\uB85C \uB418\uB3CC\uC544\uC624\uAC8C
      \uD574\uC90D\uC2DC\uB2E4."
    jp: 
    en: 
  - key: Tower.Boss.Desc.08
    ko: "\uBB50\uC57C \uB204\uAD6C\uC138\uC694."
    jp: 
    en: 
  - key: game.name.InfinityTower
    ko: "\uCC9C\uD558\uC81C\uC77C \uAFC0\uBC24\uB300\uD68C"
    jp: 
    en: 
  - key: game.desc.InfinityTower
    ko: "\uAC01 \uCE35\uB9C8\uB2E4 \uC788\uB294 \uD558\uB12C\uACFC \uC804\uD22C\uD569\uB2C8\uB2E4.\n\n\uB098,
      \uD558\uB12C \uC21C\uC11C\uB300\uB85C 20\uD134\uC744 \uC9C4\uD589\uD558\uBA70\n20\uD134\uC774
      \uC9C0\uB098\uAE30 \uC804, \uB0B4 HP\uAC00 0\uC774 \uB418\uAE30 \uC804\uC5D0\n\uD558\uB12C\uC758
      HP\uB97C 0\uC73C\uB85C \uB9CC\uB4E4\uBA74 \uC2B9\uB9AC\uD558\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\n\uBCF8\uC778\uC758
      \uB808\uBCA8\uACFC \uAC15\uD654\uD55C \uC2A4\uD0EF,\n\uBB34\uAE30\uB97C \uAD6C\uB9E4\uD558\uC5EC
      \uCD94\uAC00\uB85C \uAC15\uD574\uC9C4 \uB4A4\uC5D0\n\uD558\uB12C\uACFC \uC804\uD22C\uD558\uC5EC
      \uD558\uB12C\uC744 \uAFC0\uBC24\uC73C\uB85C \uBB3C\uB9AC\uCE58\uC138\uC694!"
    jp: 
    en: 
  - key: game.desc.Enchant.User
    ko: "\uBCF8\uC778 \uC2A4\uD0EF\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4.\n\n\uACF5\uACA9\uB825,
      \uBC29\uC5B4\uB825, \uCCB4\uB825\uC740 <b>\uBCF8\uC778\uC758 \uB808\uBCA8 +
      \uAC15\uD654\uD55C \uC2A4\uD0EF\uC758 \uC218\uCE58</b>\uB97C \uB530\uB985\uB2C8\uB2E4.\n\n\uD06C\uB9AC\uD2F0\uCEEC
      \uD655\uB960, \uD06C\uB9AC\uD2F0\uCEEC \uB370\uBBF8\uC9C0\uB294 <b>\uAC15\uD654\uD55C
      \uC2A4\uD0EF\uC758 \uC218\uCE58</b>\uB97C \uB530\uB985\uB2C8\uB2E4.\n\n\uAC15\uD654\uC5D0\uB294
      \uACE8\uB4DC\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\uBBF8\uB2C8\uAC8C\uC784\uC744
      \uD074\uB9AC\uC5B4\uD558\uAC70\uB098, \uAFC0\uBC24\uB300\uD68C\uC5D0\uC11C
      \uC6B0\uC2B9\uD558\uC5EC \uCF54\uC778\uC744 \uD68D\uB4DD\uD558\uACE0\n\uACE8\uB4DC\uB85C
      \uC2A4\uD0EF\uC744 \uAC15\uD654\uD558\uC138\uC694!"
    jp: 
    en: 
  - key: game.desc.Enchant.Weapon
    ko: "\uBB34\uAE30\uB97C \uAC15\uD654\uD558\uC5EC \uBCF8\uC778 \uC2A4\uD0EF\uC744
      \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4.\n\n\uBB34\uAE30\uB97C \uAC15\uD654\uD558\uC5EC
      \uBCF8\uC778 \uC2A4\uD0EF\uC5D0 \uCD94\uAC00\uC801\uC73C\uB85C\n\uACF5\uACA9\uB825,
      \uD06C\uB9AC\uD2F0\uCEEC \uB370\uBBF8\uC9C0\uB97C \uC99D\uAC00\uC2DC\uD0AC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB4F1\uAE09\uC744 \uC62C\uB9AC\uAC8C \uB418\uBA74,
      \uACF5\uACA9\uB825\uACFC \uD06C\uB9AC\uD2F0\uCEEC \uB370\uBBF8\uC9C0\uAC00
      \uB3D9\uC2DC\uC5D0 \uC0C1\uC2B9\uD569\uB2C8\uB2E4.\n\n\uBB34\uAE30\uB97C \uAC15\uD654\uC2DC
      \uD2B9\uC815 \uB7C9\uC758 \uCF54\uC778\uC744 \uC18C\uBAA8\uD558\uACE0\n<b>\uAC15\uD654
      \uC131\uACF5, \uAC15\uD654 \uC720\uC9C0, \uB4F1\uAE09 \uD558\uB77D</b>\n3\uAC00\uC9C0\uC911
      \uD558\uB098\uC758 \uACB0\uACFC\uAC00 \uB098\uC635\uB2C8\uB2E4.\n\n<b>\uAC15\uD654
      \uC131\uACF5</b>\uC2DC \uC0C1\uC704 \uB4F1\uAE09\uC73C\uB85C \uC0C1\uC2B9,\n<b>\uAC15\uD654
      \uC720\uC9C0</b>\uC2DC \uD604\uC7AC \uB4F1\uAE09 \uC73C\uB85C \uC720\uC9C0\uB418\uBA70,\n<b>\uB4F1\uAE09
      \uD558\uB77D</b>\uC2DC \uD558\uB098 \uC544\uB798 \uB4F1\uAE09\uC5D0\uC11C \uB2E4\uC2DC
      \uC62C\uB77C\uC640\uC57C \uD569\uB2C8\uB2E4.\n\n<b>\uB4F1\uAE09 \uD558\uB77D</b>\uC2DC
      \uD558\uB77D\uD55C \uB4F1\uAE09\uC5D0\uC11C\uC758 \uB4F1\uAE09 \uD558\uB77D\uC740
      0%\uAC00 \uB418\uBA70,\n<b>\uB4F1\uAE09 \uC720\uC9C0</b>\uAC00 \uAE38\uC5B4\uC9C8
      \uACBD\uC6B0, \uAC15\uD654 \uC131\uACF5 \uD655\uB960\uC774 \uB192\uC544\uC9D1\uB2C8\uB2E4.\n\n\uB354\uC6B1\uB354
      \uAC15\uD574\uC838\uC11C \uD558\uB12C\uC5D0\uAC8C \uAC15\uD55C \uAFC0\uBC24\uC744
      \uB54C\uB9B4 \uC218 \uC788\uB3C4\uB85D \uD569\uC2DC\uB2E4!"
    jp: 
    en: 
  - key: game.name.CubeGame
    ko: "\uD050\uBE0C \uAC8C\uC784"
    jp: CubeGame
    en: CubeGame
  - key: game.desc.CubeGame
    ko: "\uBD88\uC774 \uB4E4\uC5B4\uC628 \uBC84\uD2BC\uC744 \uC815\uD655\uD55C \uD0C0\uC774\uBC0D\uC5D0
      \uD130\uCE58\uD558\uC138\uC694.\n\n30\uCD08\uB3D9\uC548 \uBC84\uD2BC\uC744
      \uB9CE\uC774 \uD130\uCE58\uD574 \uC810\uC218\uB97C \uBAA8\uC73C\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\n\uD68C\uC0C9
      - \uC8FC\uD669 - \uCD08\uB85D - \uD30C\uB791 - \uBD84\uD64D - \uBE68\uAC15\n\uC21C\uC73C\uB85C
      \uC0C9\uC774 \uBCC0\uD558\uBA70\n\uD0C0\uC774\uBC0D\uC774 \uC815\uD655\uD560\uC218\uB85D
      \uC810\uC218\uAC00 \uB9CE\uC774 \uC624\uB985\uB2C8\uB2E4.\n\n\uD68C\uC0C9\uC77C\uB54C\uB294
      \uD130\uCE58\uD560 \uC218 \uC5C6\uACE0\n\uD30C\uB791 - \uCD08\uB85D - \uC8FC\uD669
      \uC21C\uC73C\uB85C \uC810\uC218\uAC00 \uB192\uC73C\uBA70\n\uBD84\uD64D, \uBE68\uAC15\uC0C9
      \uBC84\uD2BC\uC740 \uB204\uB974\uBA74 \uC810\uC218\uAC00 \uAE4E\uC77C \uC218
      \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD30C\uB791\uC0C9\uC744 \uD130\uCE58\uD558\uBA74
      \uC81C\uD55C\uC2DC\uAC04\uB3C4 \uC57D\uAC04 \uB298\uC5B4\uB0A9\uB2C8\uB2E4.\n\n\uC810\uC218\uB97C
      \uB9CE\uC774 \uBAA8\uC544 \uACE0\uB4DD\uC810\uC744 \uB178\uB824\uBCF4\uC138\uC694!"
    jp: CubeGame
    en: CubeGame
  - key: game.name.WingTto
    ko: "\uC5F0\uBAA8\uC544 \uC719\uB610"
    jp: WingTto
    en: WingTto
  - key: game.desc.WingTto
    ko: "\uBCBD\uACFC \uC7A5\uC560\uBB3C\uC744 \uD53C\uD574 \uBA40\uB9AC\uAE4C\uC9C0
      \uB0A0\uC544\uAC00\uC138\uC694.\n\n\uC624\uB978\uCABD\uC5D0\uC11C \uB2E4\uAC00\uC624\uB294
      \uC7A5\uC560\uBB3C\uC744 \uD53C\uD574 \uB0A0\uC544\uAC00\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\n\uC624\uB978\uCABD
      \uD130\uCE58 \uB610\uB294 \uC88C\uD074\uB9AD\uC73C\uB85C \uC0C1\uC2B9, \uC190\uC744
      \uB5BC\uBA74 \uD558\uAC15\uD569\uB2C8\uB2E4.\n\uC67C\uCABD \uD130\uCE58 \uB610\uB294
      \uC6B0\uD074\uB9AD\uC73C\uB85C \uC18D\uB3C4 \uC0C1\uC2B9, \uC190\uC744 \uB5BC\uBA74
      \uAE30\uBCF8 \uC18D\uB3C4\uB85C \uB3CC\uC544\uC635\uB2C8\uB2E4.\n\n\uBCBD \uB610\uB294
      \uC7A5\uC560\uBB3C\uC5D0 \uBD80\uB52A\uCE58\uBA74 HP\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\uC911\uAC04\uC911\uAC04
      \uB098\uC624\uB294 \uC0BC\uAC01\uAE40\uBC25\uC744 \uBA39\uC73C\uBA74 HP\uAC00
      \uC77C\uBD80 \uD68C\uBCF5\uB418\uBA70\nHP\uAC00 0\uC774 \uB418\uBA74 \uAC8C\uC784\uC774
      \uC885\uB8CC\uB429\uB2C8\uB2E4.\n\n\uBA40\uB9AC \uB0A0\uC544\uAC04 \uAC70\uB9AC\uB9CC\uD07C
      \uC810\uC218\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4.\n\uC911\uAC04\uC911\uAC04
      \uB098\uC624\uB294 \uCF54\uC778\uACFC \uACBD\uD5D8\uCE58\uB97C \uBAA8\uC544
      \uBCF4\uC0C1\uC744 \uD68D\uB4DD\uD569\uC2DC\uB2E4."
    jp: WingTto
    en: WingTto

    en: 
  - key: card.desc.36
    ko: "\uC0BC\uC0AC\uB2D8\uC774 \uADF8\uB824\uC900 \uAE30\uC068\uC5D0 \uB118\uCE58\uB294
      \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC544\uC8FC \uC628\uD654\uD574\uBCF4\uC774\uB124\uC694."
    jp: 
    en: 
  - key: card.desc.37
    ko: "\uC0BC\uC0AC\uB2D8\uC774 \uADF8\uB824\uC900 \uADFC\uC5C4\uB118\uCE58\uB294

    en: 
  - key: card.desc.0
    ko: "\uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC774 \uAC8C\uC784\uC744 \uB9CC\uB4E0
      \uC0AC\uB78C\uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.1
    ko: "\uAC00\uC2AC\uC774\uC785\uB2C8\uB2E4.\n\uB178\uB798\uB97C \uC798 \uBD80\uB985\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.2
    ko: "\uAC04\uC7A5\uAC8C\uC7A5\uC785\uB2C8\uB2E4.\n\uC904\uC5EC\uC11C \uAC8C\uC7A5\uB2D8\uC774\uB77C\uACE0
      \uB9CE\uC774\uB4E4 \uBD80\uB985\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.3
    ko: "\uAF2C\uB2D0\uC785\uB2C8\uB2E4.\n\uC694\uC2DC\uB77C\uB294 \uB2C9\uB124\uC784\uC73C\uB85C\uB3C4
      \uBD88\uB9BD\uB2C8\uB2E4.\n\uBE44\uBC00\uC774 \uB9CE\uC2B5\uB2C8\uB2E4. \uB9E8\uB0A0
      \uBE44\uBC00\uC774\uB798."
    jp: 
    en: 
  - key: card.desc.4
    ko: "\uB098\uB798\uC785\uB2C8\uB2E4.\n\uADC0\uC5EC\uC6B4 \uBA58\uD1A0\uC2A4 \uACE0\uC591\uC774\uC640
      \uAC19\uC774 \uC0B4\uACE0 \uACC4\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.5
    ko: "\uB2C8\uBAA8\uC785\uB2C8\uB2E4.\n\uAD76\uC9C0\uB9C8 \uC120\uC0DD\uB2D8\uC785\uB2C8\uB2E4.\n\uC2A4\uD50C\uB798\uD230\uBCF4\uB2E4
      \uAD76\uC9C0\uB9C8\uB97C \uB354 \uC88B\uC544\uD558\uC2DC\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\n\uBCF8\uC778\uC740
      \uC544\uB2C8\uB77C\uACE0 \uD558\uC168\uC2B5\uB2C8\uB2E4. \uD760\u2026"
    jp: 
    en: 
  - key: card.desc.6
    ko: "\uB2C8\uBCA8\uC785\uB2C8\uB2E4.\n\uC694\uC815\uAC19\uC774 \uC544\uB9AC\uB530\uC6B0\uC2E0
      \uBD84\uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.7
    ko: "\uB2D0\uB9AC\uB9BD\uC785\uB2C8\uB2E4.\n\uAC8C\uC784 \uB2C9\uB124\uC784 yjyj\uC5D0
      \uB9DE\uCDB0 \uC6A9\uC790\uB2D8\uC774\uB77C\uACE0\uB3C4 \uBD80\uB985\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.8
    ko: "\uB2E4\uBBF8\uC785\uB2C8\uB2E4.\n\uC5F0\uBAA8\uC544\uC5D0\uC11C \uB178\uBBF8\uC2A4
      \uCE78\uC2A4\uD1A0\uB97C \uC131\uACF5\uD55C \uC0AC\uB78C \uC911 \uD55C\uBA85\uC785\uB2C8\uB2E4.\n\uD53C\uC790\uC640
      \uCE58\uC988 \uC5F4\uC7A5 \uB123\uC740 \uC2A4\uD30C\uAC8C\uD2F0\uB97C \uC88B\uC544\uD569\uB2C8\uB2E4.\n\uB3D9\uC232
      \uBAA8\uB2C8\uCE74\uB97C \uC81C\uC77C \uC88B\uC544\uD569\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.9
    ko: "\uB8E8\uBE44\uC785\uB2C8\uB2E4.\n\uC774\uB984\uCC98\uB7FC \uBC18\uC9DD\uBC18\uC9DD\uD569\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.10
    ko: "\uB9CC\uD0C0\uC785\uB2C8\uB2E4.\n\uC5F0\uBAA8\uC544 \uCD5C\uCD08 400\uB808\uBCA8\uC744
      \uB2EC\uC131\uD55C \uACE0\uC218\uC785\uB2C8\uB2E4.\n\uB9CC\uD0C0!"
    jp: 
    en: 
  - key: card.desc.11
    ko: "\uBA4D\uBA4D\uAC1C\uC785\uB2C8\uB2E4.\n\uAC01\uC885 \uC8FC\uB144 \uC774\uBCA4\uD2B8\uC5D0\uC11C
      \uC9C4\uD589\uC744 \uC8FC\uB85C \uB9E1\uC2B5\uB2C8\uB2E4.\n\uC5F0\uC5B4 \uCE78\uC2A4\uD1A0
      \uBC84\uC2A4\uAE30\uC0AC\uC911 \uD55C\uBD84\uC774\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.12
    ko: "\uBB38\uC785\uB2C8\uB2E4.\n\uBB38\uCC0C\uB77C\uACE0 \uBCF4\uD1B5 \uBD80\uB985\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.13
    ko: "\uBC14\uB098\uB098\uC785\uB2C8\uB2E4.\n\uBA54\uC774\uD50C \uBA69\uBBF8\uB97C
      \uADF8\uB824\uC8FC\uC2E0 \uAE08\uC190\uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.14
    ko: "\uBCF4\uB86C\uC785\uB2C8\uB2E4.\n\uB85C\uBB34\uB2D8\uC774\uB77C\uACE0 \uB9CE\uC774
      \uBD80\uB985\uB2C8\uB2E4.\n\uBB34\uB824 \uC5F0\uBAA8\uC544 \uCC3D\uC2DC\uC790\uC911
      \uD55C\uBA85\uC785\uB2C8\uB2E4.\n\uC5F0\uB450\uC0C9, \uB124\uC78E\uD074\uB85C\uBC84,
      \uD788\uB85C\uC544\uCE74 \uB370\uCFE0\uB97C \uC81C\uC77C \uC88B\uC544\uD569\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.15
    ko: "\uBE14\uB799\uC790\uBABD\uC785\uB2C8\uB2E4.\n\uBCF4\uD1B5 \uC9DC\uBABD\uC73C\uB85C
      \uBD80\uB985\uB2C8\uB2E4. \uC9DC\uBABD!"
    jp: 
    en: 
  - key: card.desc.16
    ko: "\uBE60\uB2E4\uC785\uB2C8\uB2E4.\n\uBE60\uB2E4\uAC00\uC774 \uBAA9\uC18C\uB9AC\uB97C
      \uC0AC\uC6A9\uD558\uC2E0 \uC801\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.17
    ko: "\uC0BC\uC0AC\uC785\uB2C8\uB2E4.\n\uC774 \uAC8C\uC784\uC758 \uAC01\uC885
      \uADF8\uB9BC\uC744 \uADF8\uB824\uC900 \uAE08\uC190\uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.18
    ko: "\uC138\uB178\uC785\uB2C8\uB2E4.\n\uC5F0\uBAA8\uC544\uC758 \uC720\uC77C\uD55C
      \uC678\uAD6D\uC778!\n\uC77C\uBCF8\uC5B4\uB97C \uD560 \uC904 \uC548\uB2E4\uBA74
      \uC778\uC0AC\uD574\uC8FC\uC138\uC694."
    jp: 
    en: 
  - key: card.desc.19
    ko: "\uC194\uB77C\uC785\uB2C8\uB2E4.\n\uCF69\uB2D8\uACFC \uAC19\uC774 \uB7AD\uAC9C\uACFC
      \uC5F0\uC5B4 \uB458\uB2E4 \uBB34\uC30D\uC744 \uCC0D\uC2B5\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.20
    ko: "\uC2DC\uB85C\uD0B9\uC785\uB2C8\uB2E4.\n\uC5F0\uBAA8\uC544 \uCC3D\uB9BD\uC790\uC911
      \uD55C\uBA85\uC785\uB2C8\uB2E4.\n\uADC0\uC5EC\uC6B4 \uC544\uB4DC\uB2D8\uACFC
      \uD568\uAED8 \uC77C\uBCF8\uC5D0 \uC0AC\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.21
    ko: "\uC544\uCFE0\uC2DC\uC785\uB2C8\uB2E4.\n\uC640\uBC29 \uC608\uBD84\uC138\uBCBD
      \uBCF4\uB0B4\uC138\uC694"
    jp: 
    en: 
  - key: card.desc.22
    ko: "\uC694\uBC14\uB77C\uC785\uB2C8\uB2E4.\n\uC220\uC5D0 \uCDE8\uD55C \uBA69\uBBF8?..."
    jp: 
    en: 
  - key: card.desc.23
    ko: "\uC719\uB044\uC785\uB2C8\uB2E4.\n\uC778\uAC8C\uC784\uC5D0\uC120 L'uo\uB77C\uB294
      \uB2C9\uB124\uC784\uC744 \uC0AC\uC6A9\uD558\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.24
    ko: "\uC728\uBB34\uC785\uB2C8\uB2E4.\n\uC728\uBB34\uCC28 \uC544\uB2D9\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.25
    ko: "\uC774\uB984\uC785\uB2C8\uB2E4.\n\uC778\uAC8C\uC784\uC5D0\uC120 NFIME \uB77C\uB294

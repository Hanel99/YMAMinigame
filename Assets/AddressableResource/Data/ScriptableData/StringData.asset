      \uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.26
    ko: "\uC8FC\uB514\uC785\uB2C8\uB2E4.\n\uC5F0\uC5B4 \uB178\uBBF8\uC2A4 \uCE78\uC2A4\uD1A0\uB97C
      \uB9E4\uBC88 \uD558\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.27
    ko: "\uCABC\uC774\uC785\uB2C8\uB2E4.\n\uADC0\uC5EC\uC6B4 \uC6B0\uC8FC\uC640 \uD568\uAED8
      \uC0AC\uC2ED\uB2C8\uB2E4.\nE 100%\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.28
    ko: "\uCF69\uC785\uB2C8\uB2E4.\n\uCF69\uCC0C\uB2D8\uC73C\uB85C \uC8FC\uB85C \uBD88\uB9BD\uB2C8\uB2E4.\n\uC194\uB77C\uB2D8\uACFC
      \uD568\uAED8 \uB7AD\uAC9C \uC5F0\uC5B4 \uBB34\uC30D\uC744 \uCC0D\uC2B5\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.29
    ko: "\uD0A4\uC704\uC785\uB2C8\uB2E4.\n\uADC0\uC5EC\uC6B4 \uD0A4\uC704\uC640 \uAC19\uC774
      \uC0AC\uC2ED\uB2C8\uB2E4.\n\uD0A4\uC704\uB2D8\uC758 \uBAA9\uC18C\uB9AC\uB97C
      \uB4E4\uC73C\uC2E0 \uBD84\uC740 \uC81C\uBCF4 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.30
    ko: "\uD0D0\uD0D0\uC785\uB2C8\uB2E4.\n\uD5EC\uBA67 \uB300\uC2E0 \uCEE4\uD53C\uCEF5\uC744
      \uC4F0\uACE0 \uC5F0\uC5B4\uB97C \uC7A1\uC73C\uB7EC \uB5A0\uB098\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.31
    ko: "\uD5E4\uC694\uC785\uB2C8\uB2E4.\n\uADC0\uC5EC\uC6B4 \uB530\uB2D8\uACFC \uD568\uAED8
      \uAC8C\uC784\uC744 \uAC19\uC774 \uD574\uC8FC\uC2ED\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.32
    ko: "\uD604\uBE48\uC785\uB2C8\uB2E4.\n\uAD70\uD544 \uC5EC\uACE0\uC0DD\uC774\uC2ED\uB2C8\uB2E4.\n\uBCF5\uBB34\uC2E0\uC870!"
    jp: 
    en: 
  - key: card.desc.33
    ko: "\uC5F0\uC5B4\uC54C\uC785\uB2C8\uB2E4.\n\uC5F0\uBAA8\uC544 \uC8FC\uBBFC\uC774\uB77C\uBA74
      \uD55C\uBC88\uCBE4\uC740 \uBD24\uC744 \uAC81\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.34
    ko: "\uB179\uC544\uBC84\uB9B0 \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC608\uC804\uC5D4
      \uC790\uC8FC \uB179\uACE4 \uD588\uC5C8\uC2B5\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.35
    ko: "\uD654\uB09C \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uD3C9\uC18C\uC758 \uD558\uB12C\uC774\uB124\uC694."
    jp: 
    en: 
  - key: card.desc.36
    ko: "\uC6C3\uB294 \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC88B\uC740 \uC77C\uC774\uB77C\uB3C4
      \uC788\uB358 \uAC78\uAE4C\uC694?"
    jp: 
    en: 
  - key: card.desc.37
    ko: "\uC2FC\uD0C0 \uD558\uB77C\uBD80\uC9C0\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uBA54\uB9AC
      \uD06C\uB9AC\uC2A4\uB9C8\uC2A4!"
    jp: 
    en: 
  - key: card.desc.38
    ko: "\uC3D8\uC138\uC9C0\uAC00 \uB41C \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC5B4\uCA4C\uB2E4\uAC00
      \uC3D8\uC138\uC9C0\uAC00 \uB418\uC5C8\uC744\uAE4C\uC694?"
    jp: 
    en: 
  - key: card.desc.39
    ko: "\uADFC\uBCF8 \uBCFC\uB4DC\uB9C8\uCEE4 \uD558\uC2E4\uB798\uC694?"
    jp: 
    en: 
  - key: card.desc.40
    ko: "\uC73C\uC774\uC775 \uC774\uC774\uC774\uC775 \uC73C\uC73C\uC73C\uC73C\uC774\uC789\uC774\uC774\u3163\uC775!!!"
    jp: 
    en: 
  - key: card.desc.41
    ko: "\uADC0\uC5FD\uC8E0?"
    jp: 
    en: 
  - key: card.desc.42
    ko: "\uBC14\uB098\uB098\uB2D8\uC774 \uADF8\uB824\uC900 \uBA54\uC774\uD50C \uC2DD
      \uC655\uC9C0\uB77D \uD558\uB77C\uBD80\uC9C0 \uB3C4\uD2B8 \uBC84\uC804 \uC785\uB2C8\uB2E4.\n\uB108\uBB34
      \uADC0\uC5FD\uC2B5\uB2C8\uB2E4! "
    jp: 
    en: 
  - key: card.desc.43
    ko: "\uC0BC\uC0AC\uB2D8\uC774 \uADF8\uB824\uC900 \uAE30\uC068\uC5D0 \uB118\uCE58\uB294
      \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uC544\uC8FC \uC628\uD654\uD574\uBCF4\uC774\uB124\uC694."
    jp: 
    en: 
  - key: card.desc.44
    ko: "\uC0BC\uC0AC\uB2D8\uC774 \uADF8\uB824\uC900 \uADFC\uC5C4\uB118\uCE58\uB294
      \uBAA8\uC2B5\uC758 \uD558\uB12C\uC785\uB2C8\uB2E4.\n\uB9C8\uC778\uD06C\uB798\uD504\uD2B8
      \uB2E4\uC774\uC544\uBAAC\uB4DC \uACE1\uAD2D\uC774\uB97C \uB4E4\uACE0 \uC5F0\uC5B4
      \uC544\uB974\uBC14\uC774\uD2B8\uC5D0 \uAC04 \uBAA8\uC591\uC785\uB2C8\uB2E4.\n\uB2E4\uC774\uC544\uBAAC\uB4DC
      \uACE1\uAD2D\uC774\uB294 \uC5F0\uC5B4\uD55C\uD14C \uBA87 \uB370\uBBF8\uC9C0\uAC00
      \uB4E4\uC5B4\uAC08\uAE4C\uC694?"
    jp: 
    en: 
  - key: card.desc.45
    ko: "\uC800\uB294 \uADF8\uB9CC \uC815\uC2E0\uC744 \uC783\n\uACE0\uB9D0\uC558\uC2B5\uB2C8\uB2E4"
    jp: 
    en: 
  - key: card.desc.46
    ko: "\uBA69\uBBF8 \uB9AC\uBA54\uC774\uD06C\uB97C \uBC1B\uC544 \uC774\uBED0\uC9C4
      \uAC04\uC7A5\uAC8C\uC7A5\uC785\uB2C8\uB2E4.\n\uC9D1\uAC8C\uBC1C\uC774 \uC0DD\uACBC\uC2B5\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.47
    ko: "\uC694\uD788~"
    jp: 
    en: 
  - key: card.desc.48
    ko: "\uC694\uC2DC\uC758 \uC54C\uC785\uB2C8\uB2E4.\n\uC694\uC2DC\uB294 \uC5B4\uB514\uB85C
      \uAC04 \uAC78\uAE4C\uC694?"
    jp: 
    en: 
  - key: card.desc.49
    ko: "\uC557! \uC694\uC2DC \uC54C\uC5D0\uC11C \uAF2C\uB2D0\uC774 \uD0DC\uC5B4\uB098\uB824
      \uD569\uB2C8\uB2E4!"
    jp: 
    en: 
  - key: card.desc.50
    ko: "\uBA69\uBBF8 \uB9AC\uBA54\uC774\uD06C\uB97C \uBC1B\uC544 \uC774\uBED0\uC9C4
      \uB098\uB798\uC785\uB2C8\uB2E4.\n\uAD6C\uB984\uAC19\uC774 \uB9D0\uB791\uB9D0\uB791\uD574\uC9C4
      \uBAA8\uC2B5\uC785\uB2C8\uB2E4."
    jp: 
    en: 
  - key: card.desc.51

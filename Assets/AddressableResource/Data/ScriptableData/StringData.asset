  - key: card.desc.55
    ko: "\uB9CC\uD0C0\uB2D8\uC774 \uADF8\uB824\uC900 \uD0A4\uC704\uC785\uB2C8\uB2E4.\n\uB3D9\uAE00\uB3D9\uAE00\uD558\uB2C8

  Data:
  - id: 0
    code: XP41R3
    text: "1) 3\uAC1C\uC758 \uADF8\uB9BC\uC744 \uBAA8\uC544\uB77C"
  - id: 1
    code: FSL1P2
    text: "1) \uCCAB\uBC88\uC9F8, \uB450\uBC88\uC9F8\uB294 \uD2C0\uB824\uC57C \uD55C\uB2E4"
  - id: 2
    code: AM4TCTH
    text: "1) \uC138\uBC88\uC9F8\uC5D0 \uB9DE\uC544\uC57C \uD55C\uB2E4"
  - id: 3
    code: 3MAT2CDGM
    text: "\uCE74\uB4DC \uB9DE\uCD94\uAE30 \uAC8C\uC784\uC5D0\uC11C \uCCAB\uBC88\uC9F8
      \uADF8\uB9AC\uACE0 \uB450\uBC88\uC9F8 \uC2DC\uB3C4\uB294 \uC2E4\uD328 \uD55C
      \uB4A4 \uC138\uBC88\uC9F8 \uC2DC\uB3C4\uC5D0 \uC131\uACF5\uD558\uB77C"
  - id: 4
    code: W0RVDP3
    text: "2) 3\uAC1C\uC758 \uC758\uBBF8\uB97C \uCC3E\uC544\uB77C"
  - id: 5
    code: 9CF1NP
    text: "2) \uCCAB\uBC88\uC9F8 \uB610\uB294 \uB450\uBC88\uC9F8\uC5D0 \u25A0\uB97C
      \uC785\uB825\uD558\uB77C"
  - id: 6
    code: GAM41LI
    text: "2) 3\uC73C\uB85C \uD2B8\uB9AC\uAC70\uB97C \uBC1C\uB3D9\uD558\uB77C"
  - id: 7
    code: 1S34KVH
    text: "2) 3\uBC88\uC9F8\uC5D0 \uC815\uB2F5\uC744 \uB9DE\uCDB0\uB77C"
  - id: 8
    code: 3FNDAWDGM
    text: "\uB2E8\uC5B4 \uB9DE\uCD94\uAE30 \uAC8C\uC784\uC5D0\uC11C \uCCAB\uBC88\uC9F8
      \uB610\uB294 \uB450\uBC88\uC9F8 \uC2DC\uB3C4\uC5D0 3\uC744 \uC785\uB825\uD55C
      \uB4A4 \uC138\uBC88\uC9F8 \uC2DC\uB3C4\uC5D0 \uC131\uACF5\uD558\uB77C"
  - id: 9
    code: 8SOV4K3
    text: "3) 3\uBC88 \uC0C9\uC744 \uCC3E\uC544\uB77C"
  - id: 10
    code: CVOI0R
    text: "3) \uBAA8\uB4E0 \uC0C9\uC744 \uBAA8\uC544\uC57C \uD55C\uB2E4"
  - id: 11
    code: 5KHYTIN
    text: "3) 3\uBC88\uC529\uB9CC \uBAA8\uC544\uB77C"
  - id: 12
    code: 3CB4GM5
    text: "\uD050\uBE0C \uAC8C\uC784\uC5D0\uC11C \uBAA8\uB4E0 \uC0C9\uC744 \uAC01\uAC01
      3\uBC88\uC529\uB9CC \uB204\uB978 \uB4A4 \uB05D\uB9C8\uCCD0\uB77C"
  - id: 13
    code: 1ML2NC
    text: "4) 3\uBC88 \uC6B0\uC8FC\uB97C \uC5EC\uD589\uD558\uB77C"
  - id: 14
    code: F34JT6
    text: "4) \uB9C8\uC9C0\uB9C9 \uB610\uB294 \uADF8 \uC55E\uC774\uC5B4\uC57C \uD55C\uB2E4"
  - id: 15
    code: 8SD33P
    text: "4) 3\uC77C\uB54C \uBA48\uCDB0\uB77C"
  - id: 16
    code: 3MHMTQ
    text: "\uC719\uB610\uC5D0\uC11C \uBE44\uD589 \uAC70\uB9ACm \uC22B\uC790\uC758
      \uCCAB\uBC88\uC9F8 \uB610\uB294 \uB450\uBC88\uC9F8 \uC790\uB9AC\uAC00 3\uC778
      \uCC44 \uB05D\uB9C8\uCCD0\uB77C"
  - id: 17
    code: TNKU4PLY
    text: "\uD50C\uB808\uC774 \uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
